COMPOSE_PROJECT_NAME=wams

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=wams_user
POSTGRES_PASSWORD=wams_secure_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=wams_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secure_2026
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ── Consul ────────────────────────────────────────────────────────────
CONSUL_HOST=consul
CONSUL_PORT=8500

# ── JWT (shared across all services) ──────────────────────────────────
JWT_SECRET=microservices-shared-secret-key-2026-wams-ultra-secure

# ── Authentication Service ────────────────────────────────────────────
AUTH_SECRET_KEY=django-auth-secret-key-wams-2026-ultra-secure-xyz
AUTH_DB_NAME=auth_db
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_HOST=auth-service

# ── GalleryImage Service ──────────────────────────────────────────────
GALLERY_SECRET_KEY=django-gallery-secret-key-wams-2026-ultra-secure-abc
GALLERY_DB_NAME=gallery_db
GALLERY_SERVICE_PORT=8001
GALLERY_SERVICE_HOST=gallery-service

# ── AI (smart_preprocessing) Service ─────────────────────────────────
AI_SECRET_KEY=django-ai-secret-key-wams-2026-ultra-secure-def
AI_DB_NAME=ai_db
AI_SERVICE_PORT=8002
AI_SERVICE_HOST=ai-service

# ── Historique Service ────────────────────────────────────────────────
HISTORIQUE_SECRET_KEY=django-historique-secret-key-wams-2026-ultra-secure-ghi
HISTORIQUE_DB_NAME=historique_db
HISTORIQUE_SERVICE_PORT=8003
HISTORIQUE_SERVICE_HOST=historique-service

# ── Debug (set to False in production) ───────────────────────────────
DEBUG=False
